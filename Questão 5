programa {
  funcao inicio() {
    inteiro a, b, c, seq

    escreva("Digite o primeiro valor: ")
      leia(a)
    escreva("Digite o segundo valor: ")
      leia(b)
    escreva("Digite o terceito valor: ")
      leia(c)
    
    se (a > b){
      seq = a
      a = b
      b = seq
    }se
    (a > c){
      seq = a 
      a = c 
      c = seq
    }se
    (b > c){
      seq = b
      b = c
      c = seq 
    }
    escreva ("\nOrdem crescente: ", a," ", b," ", c)    
  }
}
