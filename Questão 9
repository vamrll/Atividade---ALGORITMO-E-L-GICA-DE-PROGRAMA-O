programa {
  funcao inicio() {
    inteiro opcao
    real saldo, deposito

    saldo = 0

    enquanto (opcao != 4) {

      escreva("\n===== MENU =====")
      escreva("\n1 = Ver saldo")
      escreva("\n2 = Realizar deposito")
      escreva("\n3 = Atendimento em andamento")
      escreva("\n4 = Encerrar atendimento")
      escreva("\nEscolha uma opcao: ")
      leia(opcao)

      escolha (opcao) {

        caso 1:
          escreva("\nSaldo atual: ", saldo)
          pare

        caso 2:
          escreva("\nDigite o valor do deposito: ")
          leia(deposito)
          saldo = saldo + deposito
          escreva("\nDeposito realizado")
          pare

        caso 3:
          escreva("\nAtendimento em andamento")
          pare

        caso 4:
          escreva("\nAtendimento encerrado")
          pare

        caso contrario:
          escreva("\nOpcao invalida")
      }
    }
  }
}
